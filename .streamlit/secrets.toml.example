# ==============================================================================
# Streamlit 공식 인증(OIDC) 설정 예시 파일 (.streamlit/secrets.toml.example)
#
# 실제 인증을 사용하려면:
# 1. 이 파일을 복사하여 .streamlit/secrets.toml 파일로 생성합니다.
# 2. Google Cloud Console 등에서 발급받은 OAuth 클라이언트 정보를 입력합니다.
# 3. cookie_secret 에는 브라우저 쿠키 암호화용 무작위 문자열을 지정합니다.
# ==============================================================================

[auth]
# 1. 인증 완료 후 되돌아올 콜백 URL (포트 번호는 앱 실행 포트와 일치해야 합니다)
redirect_uri = "http://localhost:8501/oauth2callback"

# 2. 로그인 세션 쿠키를 암호화하는 비밀 키 (아무 무작위 긴 문자열이나 입력)
cookie_secret = "super-secret-cookie-encryption-key-change-me"

# 3. OpenID Connect (OIDC) 제공자 정보 (예: Google)
client_id = "your-client-id.apps.googleusercontent.com"
client_secret = "your-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

